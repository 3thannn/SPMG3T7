# Copy to backend/.env and fill in from your Supabase dashboard.
# .env is gitignored — the values below are secrets and must never be committed.
# Copy this file rather than renaming it, so the template stays in the repo.

# --- Supabase ---
# Project Settings > Data API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings > API Keys > anon / public.
# Used for sign-in, so it is subject to Row Level Security.
SUPABASE_ANON_KEY=

# Project Settings > API Keys > service_role.
# FULL ADMIN, bypasses Row Level Security. Backend only — never send it to the
# browser and never put it behind a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, and unused by the API, which goes through PostgREST. Set it only if
# you want to read the schema directly (Row Level Security policies, say).
# Connect > Session pooler — not the direct connection, which is IPv6-only.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Existing settings, shown so this file is the whole picture ---
# CORS_ORIGINS=http://localhost:5173
# SESSION_IDLE_MINUTES=30
# SEED_PASSWORD=Sprint1!demo
